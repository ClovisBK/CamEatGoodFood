    "/api/Recipes/Add-recipe": {
      "post": {
        "tags": [
          "Recipes"
        ],
        "summary": "Creating recipe alongside the ingredients and instructions by a contributor",
        "description": "**The following are the operations here:**\r\n* Retrieving the authenticated user and verifying for authorization\r\n* Validating the required input fields to ensure they are input\r\n* Extrating the recipes and verifying availability before adding\r\n* Adding instruction fields to the intructions section in the model\r\n* Adding the recipe fields themselves accordingly",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "Name": {
                    "type": "string"
                  },
                  "Description": {
                    "type": "string"
                  },
                  "CategoryId": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "PrepTimeMinutes": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "CookTimeMinutes": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "Servings": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "ImageFile": {
                    "type": "string",
                    "format": "binary"
                  },
                  "VideoFile": {
                    "type": "string",
                    "format": "binary"
                  },
                  "RegionOfOrigin": {
                    "type": "string"
                  },
                  "RecipeIngredient": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/CreateRecipeIngredientDto"
                    }
                  },
                  "RecipeInstruction": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/CreateRecipeInstructionDto"
                    }
                  }
                }
              },
              "encoding": {
                "Name": {
                  "style": "form"
                },
                "Description": {
                  "style": "form"
                },
                "CategoryId": {
                  "style": "form"
                },
                "PrepTimeMinutes": {
                  "style": "form"
                },
                "CookTimeMinutes": {
                  "style": "form"
                },
                "Servings": {
                  "style": "form"
                },
                "ImageFile": {
                  "style": "form"
                },
                "VideoFile": {
                  "style": "form"
                },
                "RegionOfOrigin": {
                  "style": "form"
                },
                "RecipeIngredient": {
                  "style": "form"
                },
                "RecipeInstruction": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/update-recipe{id}": {
